# Copy this file to .env.local (on your computer) or add these in the hosting
# site's environment settings. Never commit real values.

# Postgres connection string. In Supabase: Project Settings > Database >
# Connection string > "Transaction pooler". Leave unset to run from the
# config files with every seat open (preview mode).
DATABASE_URL=

# The site's public address, used for Stripe's return links and email links.
SITE_URL=http://localhost:3000

# Stripe, test mode. Dashboard > Developers > API keys: the "Secret key" (sk_test_...).
STRIPE_SECRET_KEY=
# Dashboard > Developers > Webhooks > your endpoint > "Signing secret" (whsec_...).
STRIPE_WEBHOOK_SECRET=

# Testing without Stripe: set to 1 for a stand-in payment page. Ignored once STRIPE_SECRET_KEY is set.
FAKE_PAYMENTS=

# Confirmation emails through Resend (resend.com). Without a key, emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=Winter Performance Tickets <tickets@your-school-domain.org>
